<Window x:Class="VRChatNotification.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VRChatNotification"
        mc:Ignorable="d"
        Title="VRChatNotification" Height="450" Width="800" Background="#FFF3F3F3"
        ResizeMode="CanMinimize">
    <Window.Resources>
        <!-- 全てのボタンに自動適用される共通スタイル -->
        <Style TargetType="Button">
            <!-- 標準の枠線や文字色（必要に応じて調整してください） -->
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontSize" Value="14"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- 各ボタンで指定された Background をそのまま背景にする -->
                        <Border Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}"
                            SnapsToDevicePixels="True">
                            <Grid>
                                <!-- ホバー時に重ねる半透明の黒レイヤー -->
                                <Border x:Name="HoverLayer" Background="Black" Opacity="0"/>

                                <!-- ボタンの文字表示 -->
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- マウスホバー時に15%の黒（灰色）を重ねる -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverLayer" Property="Opacity" Value="0.15"/>
                            </Trigger>
                            <!-- ついでにクリックされた瞬間（押下時）はもう少し暗くする設定 -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverLayer" Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Height" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <!-- 背景側の溝(グレー) -->
                            <Border Height="4" Background="#FFE5E5E5" CornerRadius="2" VerticalAlignment="Center"/>

                            <Track x:Name="PART_Track">
                                <!-- つまみより左側(現在値までの部分)に色を付ける -->
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="#FFC1E5ED" CornerRadius="2" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>

                                <!-- つまみより右側は透明(クリックで大きく増やす用の当たり判定だけ) -->
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>

                                <!-- つまみ本体(白い丸+水色の枠) -->
                                <Track.Thumb>
                                    <Thumb x:Name="SliderThumb" Width="16" Height="16">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse x:Name="ThumbEllipse" Fill="White" Stroke="#FFC1E5ED" StrokeThickness="2"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbEllipse" Property="StrokeThickness" Value="3"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- ヘッダー(タイトル・説明・ユーザー情報) -->
            <RowDefinition Height="*"/>
            <!-- インスタンス設定(見出し+ボタン一覧) 残り全部 -->
            <RowDefinition Height="76"/>
            <!-- 下段(音量・インスタンス種類・中断ボタン) 固定高さ -->
        </Grid.RowDefinitions>

        <!-- Row 0: ヘッダー -->
        <Grid Grid.Row="0" Margin="31,7,31,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto" MaxWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- 左側: タイトル・説明(残り幅いっぱい、右側の分は自動で圧迫される) -->
            <Grid Grid.Column="0">
                <TextBlock x:Name="Title" Text="VRChatNotification" FontSize="20" Foreground="#FF2C2C2C"/>
                <TextBlock x:Name="Description" Margin="0,29,0,0" Text="ユーザーが参加した際に通知音を流します。" Foreground="#FF2C2C2C"/>
            </Grid>

            <!-- 右側: ユーザー情報専用の列(最大300pxまで、それ以上は省略表示) -->
            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <TextBlock x:Name="authUserNameTextBlock" Text="UserName" Foreground="#FF2C2C2C"
                   HorizontalAlignment="Right" TextAlignment="Right"
                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                <TextBlock x:Name="authUserIdTextBlock" Text="UserId" Foreground="#FF2C2C2C" Margin="0,4,0,0"
                   HorizontalAlignment="Right" TextAlignment="Right"
                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </StackPanel>
        </Grid>

        <!-- Row 1: インスタンス設定見出し＋ボタン一覧＋注記 -->
        <Grid Grid.Row="1" Margin="31,10,31,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="#FFE5E5E5" BorderThickness="1" CornerRadius="10,10,0,0" Background="#FFD6D7DA">
                <TextBlock Margin="9,4,6,4" Text="インスタンス設定" FontSize="14" Foreground="#FF2C2C2C"/>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Button x:Name="publicBtn" Grid.Row="0" Grid.Column="0" Content="パブリック" Background="White" BorderBrush="#FFE5E5E5" Click="publicBtn_Click" Foreground="#FF2C2C2C"/>
                <Button x:Name="groupPublicBtn" Grid.Row="0" Grid.Column="1" Content="グループパブリック" Background="White" BorderBrush="#FFE5E5E5" Click="groupPublicBtn_Click" Foreground="#FF2C2C2C"/>
                <Button x:Name="groupPlusBtn" Grid.Row="1" Grid.Column="0" Content="グループ+" Background="#FFB9DED4" BorderBrush="#FFE5E5E5" Click="groupPlusBtn_Click" Foreground="#FF2C2C2C"/>
                <Button x:Name="groupBtn" Grid.Row="1" Grid.Column="1" Content="グループオンリー" Background="#FFB9DED4" BorderBrush="#FFE5E5E5" Click="groupBtn_Click" Foreground="#FF2C2C2C"/>
                <Button x:Name="hiddenBtn" Grid.Row="2" Grid.Column="0" Content="フレンド+" Background="#FFC7B8DB" BorderBrush="#FFE5E5E5" Click="hiddenBtn_Click" Foreground="#FF2C2C2C"/>
                <Button x:Name="friendsBtn" Grid.Row="2" Grid.Column="1" Content="フレンドオンリー" Background="#FFC7B8DB" BorderBrush="#FFE5E5E5" Click="friendsBtn_Click" Foreground="#FF2C2C2C"/>
                <Button x:Name="privatePlusBtn" Grid.Row="3" Grid.Column="0" Content="インバイト+" Background="#FFC7B8DB" BorderBrush="#FFE5E5E5" Tag="0,0,0,10" Click="privatePlusBtn_Click" Foreground="#FF2C2C2C"/>
                <Button x:Name="privateBtn" Grid.Row="3" Grid.Column="1" Content="インバイトオンリー" Background="#FFC7B8DB" BorderBrush="#FFE5E5E5" Tag="0,0,10,0" Click="privateBtn_Click" Foreground="#FF2C2C2C"/>
            </Grid>

            <!-- 注記行: 左に説明、右に凡例 -->
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="※クリックで変更できます。" FontSize="10" Foreground="#FF595959"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                        <Rectangle Width="10" Height="10" Fill="White" Stroke="#FFE5E5E5" StrokeThickness="1" VerticalAlignment="Center"/>
                        <TextBlock Text="通知音無し" FontSize="10" Foreground="#FF2C2C2C" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                        <Rectangle Width="10" Height="10" Fill="#FFB2D2D2" VerticalAlignment="Center"/>
                        <TextBlock Text="入室のみ" FontSize="10" Foreground="#FF2C2C2C" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="10" Height="10" Fill="#FFBFB2D2" VerticalAlignment="Center"/>
                        <TextBlock Text="入退出含め" FontSize="10" Foreground="#FF2C2C2C" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Row 2: 下段(音量・インスタンス種類・中断ボタン) -->
        <Grid Grid.Row="2" Margin="31,0,31,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="34"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="34"/>
                <ColumnDefinition Width="126"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#FFE5E5E5" BorderThickness="1" Background="White" CornerRadius="10,10,10,10" Margin="0,0,0,14">
                <Grid>
                    <Button Content="確認" HorizontalAlignment="Left" Click="Ignition" Width="48" Background="#FFFFE2A2" Foreground="#FF2C2C2C" Margin="272,0,0,0" Tag="0,10,10,0" BorderBrush="#FFE5E5E5"/>
                    <TextBlock x:Name="currentVolumeText" HorizontalAlignment="Left" Margin="236,5,0,0" VerticalAlignment="Top" Width="30" Foreground="#FF2C2C2C"><Run Language="ja-jp" Text="100%"/></TextBlock>
                    <TextBlock HorizontalAlignment="Left" Margin="10,5,0,0" VerticalAlignment="Top" Foreground="#FF2C2C2C"><Run Language="ja-jp" Text="現在の音量"/></TextBlock>
                    <Slider x:Name="volumeSlider" HorizontalAlignment="Left" Margin="46,35,0,0" VerticalAlignment="Top" Width="188" Maximum="100" Value="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged"/>
                    <Rectangle HorizontalAlignment="Left" Height="1" Margin="0,26,0,0" Stroke="#FFE5E5E5" VerticalAlignment="Top" Width="272"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" BorderBrush="#FFE5E5E5" BorderThickness="1" Background="White" CornerRadius="10,10,10,10" Margin="0,0,0,14">
                <Grid>
                    <TextBlock x:Name="currentInstanceText" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,37,0,0" Text="ログ解析中" Foreground="#FF2C2C2C"/>
                    <Rectangle HorizontalAlignment="Center" Height="2" Stroke="#FFE5E5E5" VerticalAlignment="Center" Width="266"/>
                    <TextBlock HorizontalAlignment="Left" Margin="10,6,0,2" Text="現在のインスタンス種類" Foreground="#FF2C2C2C"/>
                </Grid>
            </Border>

            <Button x:Name="interruptButton" Grid.Column="4" Content="中断:再生" Click="boolButton_Click" Background="#FFC1E5ED" Foreground="#FF2C2C2C" Tag="10" Margin="0,0,0,14"/>
        </Grid>
    </Grid>
</Window>